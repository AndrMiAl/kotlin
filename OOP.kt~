

import kotlin.system.exitProcess

// ===== Интерфейсы предметной области ========================================
interface Named { val name: String }
interface HasScreen { val screenInches: Double }
interface HasEInkGen { val generation: EInkGeneration }
interface HasColors { val colors: Int }

// ===== Модели ===============================================================
abstract class EBook(
    override val name: String,
    override val screenInches: Double
) : Named, HasScreen

enum class EInkGeneration { PEARL, VIZPLEX }

class EInkBook(
    name: String,
    screenInches: Double,
    override val generation: EInkGeneration
) : EBook(name, screenInches), HasEInkGen

class LcdBook(
    name: String,
    screenInches: Double,
    override val colors: Int
) : EBook(name, screenInches), HasColors

// ===== Хранилище ============================================================
interface Library {
    fun add(book: EBook)
    fun all(): List<EBook>
    fun onlyEInk(): List<EInkBook>
    fun onlyLCD(): List<LcdBook>
}

class InMemoryLibrary : Library {
    private val books = mutableListOf<EBook>()
    override fun add(book: EBook) { books += book }
    override fun all(): List<EBook> = books.toList()
    override fun onlyEInk(): List<EInkBook> = books.filterIsInstance<EInkBook>()
    override fun onlyLCD(): List<LcdBook> = books.filterIsInstance<LcdBook>()
}

// ===== Сервис (через интерфейс) =============================================
interface BookService {
    fun add(book: EBook)
    fun getAll(): List<EBook>
    fun getOnlyEInk(): List<EInkBook>
    fun getOnlyLCD(): List<LcdBook>
    fun getOverScreenSize(minInches: Double): List<EBook>
}

class EBookService(private val lib: Library) : BookService {
    override fun add(book: EBook) = lib.add(book)
    override fun getAll(): List<EBook> = lib.all()
    override fun getOnlyEInk(): List<EInkBook> = lib.onlyEInk()
    override fun getOnlyLCD(): List<LcdBook> = lib.onlyLCD()
    override fun getOverScreenSize(minInches: Double): List<EBook> =
        lib.all().filter { it.screenInches > minInches }
}

// ===== Презентация: info вынесено из моделей ================================
interface Presenter {
    fun added(b: EBook)
    fun list(title: String, items: List<EBook>)
}

class EBookPresenter(private val out: (String) -> Unit = ::println) : Presenter {

    private fun render(b: EBook): String {
        val base = "\"${b.name}\", экран ${"%.1f".format(b.screenInches)}\""
        return when (b) {
            is EInkBook -> "E-Ink: $base, поколение ${b.generation}"
            is LcdBook  -> "LCD: $base, цветов: ${b.colors}"
            else        -> base
        }
    }

    override fun added(b: EBook) = out("✓ Добавлено: ${render(b)}")

    override fun list(title: String, items: List<EBook>) {
        out(title)
        if (items.isEmpty()) {
            out("— пусто —")
        } else {
            items.forEachIndexed { i, book -> out("${i + 1}. ${render(book)}") }
        }
    }
}

// ===== Ошибки (интерфейс + реализация) ======================================
interface Errors {
    fun show(message: String)
    /** Универсальная обёртка: принимает произвольные проверки-условия */
    fun <T> safe(vararg checks: Pair<Boolean, String>, block: () -> T): T?
}

class ConsoleErrors(private val out: (String) -> Unit = ::println) : Errors {
    override fun show(message: String) = out("Ошибка: $message")

    // 3-я правка: только условия, без «числовых» параметров
    override fun <T> safe(vararg checks: Pair<Boolean, String>, block: () -> T): T? {
        val firstFailed = checks.firstOrNull { (ok, _) -> !ok }
        if (firstFailed != null) {
            show(firstFailed.second)
            return null
        }
        return try {
            block()
        } catch (e: Exception) {
            show(e.message ?: "неизвестная ошибка")
            null
        }
    }
}


// ===== Безопасный ввод: возвращаем null при EOF (^D) ========================
private fun promptReadLine(prompt: String): String? {
    print(prompt)
    return readlnOrNull()?.trim()
}

private fun readNonBlank(prompt: String): String? {
    while (true) {
        val s = promptReadLine(prompt) ?: return null // EOF → отмена
        if (s.isNotEmpty()) return s
        println("Поле не должно быть пустым.")
    }
}

private fun readDouble(prompt: String): Double? {
    while (true) {
        val s = promptReadLine(prompt) ?: return null // EOF → отмена
        s.toDoubleOrNull()?.let { return it }
        println("Введите число (например, 6.0).")
    }
}

private fun readInt(prompt: String): Int? {
    while (true) {
        val s = promptReadLine(prompt) ?: return null // EOF → отмена
        s.toIntOrNull()?.let { return it }
        println("Введите целое число (например, 16777216).")
    }
}

private fun readEInkGen(prompt: String): EInkGeneration? {
    val variants = EInkGeneration.entries.joinToString { it.name }
    while (true) {
        val s = promptReadLine("$prompt [$variants]: ") ?: return null // EOF → отмена
        when (s.uppercase()) {
            "PEARL" -> return EInkGeneration.PEARL
            "VIZPLEX" -> return EInkGeneration.VIZPLEX
        }
        println("Неверное значение. Допустимо: $variants.")
    }
}

// ===== Точка входа: меню и ввод с клавы =====================================
fun main() {
    val library: Library = InMemoryLibrary()
    val service: BookService = EBookService(library)
    val presenter: Presenter = EBookPresenter()
    val errors: Errors = ConsoleErrors()

    fun addEInk() {
        val name = readNonBlank("Название: ") ?: run {
            println("\n^D — отмена ввода E-Ink."); return
        }
        val inches = readDouble("Диагональ (дюймы): ") ?: run {
            println("\n^D — отмена ввода E-Ink."); return
        }
        val gen = readEInkGen("Поколение E-Ink") ?: run {
            println("\n^D — отмена ввода E-Ink."); return
        }

        errors.safe(
            (name.isNotBlank()) to "Название не должно быть пустым",
            (inches > 0) to "Размер экрана должен быть больше 0"
        ) {
            val book = EInkBook(name, inches, gen)
            service.add(book)
            presenter.added(book)
        }
    }

    fun addLCD() {
        val name = readNonBlank("Название: ") ?: run {
            println("\n^D — отмена ввода LCD."); return
        }
        val inches = readDouble("Диагональ (дюймы): ") ?: run {
            println("\n^D — отмена ввода LCD."); return
        }
        val colors = readInt("Число цветов: ") ?: run {
            println("\n^D — отмена ввода LCD."); return
        }

        errors.safe(
            (name.isNotBlank()) to "Название не должно быть пустым",
            (inches > 0) to "Размер экрана должен быть больше 0",
            (colors > 0) to "Число цветов должно быть больше 0"
        ) {
            val book = LcdBook(name, inches, colors)
            service.add(book)
            presenter.added(book)
        }
    }

    fun lists() {
        presenter.list("\nВсе книги:", service.getAll())
        presenter.list("\nТолько E-Ink:", service.getOnlyEInk())
        presenter.list("\nТолько LCD:", service.getOnlyLCD())
        val min = readDouble("\nПорог диагонали для фильтра (>): ") ?: run {
            println("\n^D — отмена фильтра."); return
        }
        presenter.list(
            "\nКниги с экраном > ${"%.1f".format(min)}\":",
            service.getOverScreenSize(min)
        )
    }


    while (true) {
        println(
            """
            
            ===== Меню =====
            1) Добавить E-Ink
            2) Добавить LCD
            3) Показать списки
            0) Выход
            """.trimIndent()
        )
        val choice = promptReadLine("Выбор: ") ?: run {
            println("\nEOF (^D) — выходим.")
            exitProcess(0)
        }
        when (choice) {
            "1" -> addEInk()
            "2" -> addLCD()
            "3" -> lists()
            "0" -> {
                println("Пока!")
                return
            }
            else -> println("Неизвестная команда.")
        }
    }
}
