fun main() =
    generateSequence { readlnOrNull()?.trim()?.takeIf { it.isNotEmpty() } }   // читаем до пустой строки ленивая последовательность
        .mapNotNull { ln ->
            val parts = ln.split(" ")
            if (parts.size < 3) {
                println("Ошибка во вводе данных.")
                null
            } else {
                val grades = parts.drop(2).mapNotNull { it.toIntOrNull() }
                if (
                    grades.size != parts.size - 2 ||
                    grades.isEmpty() ||
                    grades.any { it !in 1..5 }
                ) {
                    println("Ошибка во вводе данных.")
                    null
                } else {
                    val s = grades.sorted()
                    val m = if (s.size % 2 == 1)
                        s[s.size / 2].toDouble()
                    else
                        (s[s.size / 2 - 1] + s[s.size / 2]) / 2.0
                    Triple("${parts[0]} ${parts[1]}", ln, m)  // (ФИО, строка, медиана)
                }
            }
        }
        .toList()
        .let { list ->
            if (list.isEmpty()) {
                "Нет корректных данных."
            } else {
                val sorted = list.sortedWith(
                    compareByDescending<Triple<String, String, Double>> { it.third }//компаратор несколько значений
                        .thenBy { it.first.lowercase() }
                )
                val cut = sorted.getOrNull(2)?.third ?: 0.0
                sorted
                    .filter { it.third >= cut }
                    .sortedBy { it.first.lowercase() }// при равенстве — по алфавиту
                    .joinToString("\n") { it.second } // выводим ровно введённые строки
            }
        }
        .let(::println)
